#!/bin/busybox sh
# g86m: stops the machine with the disk whole. What is written goes out, the root becomes
# read-only, and the kernel halts, at which g86m stops. (Ctrl-] stops g86m at once, with
# whatever was on its way to the disk lost and the file system perhaps broken, if g86m was
# started with --keep; without it nothing reaches the image and there is nothing to break.)
bb=/bin/busybox
$bb sync
$bb mount -o remount,ro / 2>/dev/null
exec $bb poweroff -f
